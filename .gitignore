# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# Local data created by the app at runtime:
# the SQLite database and uploaded wedding photos
data/
uploads/

# Environment variables (secrets live here — never commit them)
.env
.env.local
.env.*.local

# Credential files downloaded from the Google Cloud console. This app never
# reads them — it only needs NEXT_PUBLIC_GOOGLE_CLIENT_ID — but they land in
# the project folder easily, and they must never be committed.
client_secret_*.json
*-credentials.json
service-account*.json

# OS / editor noise
.DS_Store
*.log

# Editor-agent instruction files that `next dev` writes at the project root.
# Only the two documents that belong to the project are kept.
/*.md
!/README.md
!/DEPLOY.md

# Personal notes kept next to the project
further ideas.txt

# Screenshots dropped into the project folder
/Screenshot*.png
