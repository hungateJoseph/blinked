# Copy this file to `.env.local` and fill in the values.
# The app runs without any of these, but with reduced features (see README).

# --- AI features (schedule generation + AI Image Cleanup) -------------------
# Get a key at https://console.anthropic.com/
# Without it the app falls back to a simple rule-based scheduler and a local
# blur check instead of calling Claude.
ANTHROPIC_API_KEY=

# --- "Sign in with Google" ---------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000 under "Authorized JavaScript origins".
# Without it the Google button is hidden and only email sign-in is offered.
GOOGLE_CLIENT_ID=

# --- Importing photos from Google Drive ---------------------------------------
# Needs GOOGLE_CLIENT_ID above, plus an API key and two enabled APIs:
#   1. Google Cloud console -> APIs & Services -> Library:
#        enable "Google Drive API" and "Google Picker API"
#   2. Credentials -> Create credentials -> API key
#      (restrict it to those two APIs, and to your domain, before going live)
# Blinked asks only for the drive.file scope, which grants access to the files
# you pick and nothing else, so no Google verification review is required.
# Without this the Drive import section is hidden; uploading from disk is
# unaffected.
GOOGLE_API_KEY=

# --- Login cookie signing secret ---------------------------------------------
# Any long random string. Generate one with:  openssl rand -hex 32
# In development a built-in placeholder is used if this is empty.
# REQUIRED in production — the server refuses to start without it.
SESSION_SECRET=

# --- Sending the sign-in code (production) -----------------------------------
# Without these the code is printed to the server console and shown on the
# login page, which is fine locally. In production, email sign-in is refused
# until a provider is configured. See DEPLOY.md.
RESEND_API_KEY=
EMAIL_FROM=

# Where Smart Photographer workflow requests that need a person or the
# developers are sent. Defaults to the beta team inbox when empty.
TEAM_EMAIL=

# --- Prepaid credit for the workflow analysis (Stripe) -------------------------
# Photographers top up on Stripe's hosted Checkout page; a signed webhook
# credits their balance, and each analysis pass is charged its actual API
# cost. See DEPLOY.md for the three-step setup. With these empty, billing is
# off and analyses are free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Texting the Smart Photographer (Twilio) ----------------------------------
# Photographers verify their mobile under Smart Photographer -> Texting, then
# text the assistant and get short replies back; the assistant can also text
# them. Point the Twilio number's "A message comes in" webhook at
# https://<your domain>/api/sms/twilio (HTTP POST). See DEPLOY.md.
# Left empty, outgoing texts are printed to the server console and the
# verification code is shown on the page (development only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: a Messaging Service SID instead of a single From number.
TWILIO_MESSAGING_SERVICE_SID=

# --- Dev code for the workflow analysis ---------------------------------------
# Entering this code on the Skills step unlocks the bigger (and dearer) models
# for the analysis: Sonnet 5 and Opus 5 instead of Haiku 4.5. Any long random
# string; generate one with:  openssl rand -hex 8
# Left empty, only the Standard tier exists.
ANALYSIS_DEV_CODE=

# --- Storage locations (production only) --------------------------------------
# Point these at a disk that survives redeploys. Left empty, the app uses
# ./data and ./uploads next to the project, which is what you want locally.
DATA_DIR=
UPLOAD_DIR=
